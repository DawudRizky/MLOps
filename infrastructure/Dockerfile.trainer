# Dockerfile for BERTopic Trainer
FROM python:3.11-slim

WORKDIR /app

# Install system dependencies including build tools for ML libraries
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    gcc \
    g++ \
    gfortran \
    libopenblas-dev \
    liblapack-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements (use src/requirements.txt)
COPY src/requirements.txt .

# Install Python dependencies
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# Pre-download IndoBERT model (recommended for production)
RUN python -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('indobenchmark/indobert-base-p1')"

# Copy application code
COPY src/trainer /app/trainer
COPY src/common /app/common

# Create directories
RUN mkdir -p /app/models /app/reports

# Run trainer service
CMD ["python", "-m", "trainer.main"]
