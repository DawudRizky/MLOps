{
  "title": "MLOps Infrastructure Health",
  "uid": "mlops-infrastructure",
  "timezone": "browser",
  "schemaVersion": 16,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "System Memory Usage",
      "type": "graph",
      "datasource": "Prometheus",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [
        {
          "expr": "(1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100",
          "legendFormat": "Memory Used %",
          "refId": "A"
        },
        {
          "expr": "(node_memory_SwapTotal_bytes - node_memory_SwapFree_bytes) / node_memory_SwapTotal_bytes * 100",
          "legendFormat": "Swap Used %",
          "refId": "B"
        }
      ],
      "yaxes": [
        {"format": "percent", "max": 100, "min": 0},
        {"format": "short"}
      ],
      "alert": {
        "conditions": [
          {
            "evaluator": {"params": [90], "type": "gt"},
            "operator": {"type": "and"},
            "query": {"params": ["A", "5m", "now"]},
            "reducer": {"params": [], "type": "avg"},
            "type": "query"
          }
        ],
        "executionErrorState": "alerting",
        "frequency": "60s",
        "handler": 1,
        "name": "High Memory Usage",
        "noDataState": "no_data"
      }
    },
    {
      "id": 2,
      "title": "CPU Usage",
      "type": "graph",
      "datasource": "Prometheus",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [
        {
          "expr": "(1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m]))) * 100",
          "legendFormat": "CPU Used %",
          "refId": "A"
        }
      ],
      "yaxes": [
        {"format": "percent", "max": 100, "min": 0},
        {"format": "short"}
      ]
    },
    {
      "id": 3,
      "title": "Container Memory Usage (Top 10)",
      "type": "graph",
      "datasource": "Prometheus",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [
        {
          "expr": "topk(10, container_memory_usage_bytes{id=~\"/system.slice/docker-.*\"}) / 1024 / 1024",
          "legendFormat": "{{id}}",
          "refId": "A"
        }
      ],
      "yaxes": [
        {"format": "megabytes"},
        {"format": "short"}
      ]
    },
    {
      "id": 4,
      "title": "Container CPU Usage (Top 10)",
      "type": "graph",
      "datasource": "Prometheus",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [
        {
          "expr": "topk(10, rate(container_cpu_usage_seconds_total{id=~\"/system.slice/docker-.*\"}[5m]) * 100)",
          "legendFormat": "{{id}}",
          "refId": "A"
        }
      ],
      "yaxes": [
        {"format": "percent"},
        {"format": "short"}
      ]
    },
    {
      "id": 5,
      "title": "Disk Usage",
      "type": "gauge",
      "datasource": "Prometheus",
      "gridPos": {"h": 8, "w": 6, "x": 0, "y": 16},
      "targets": [
        {
          "expr": "(1 - (node_filesystem_avail_bytes{mountpoint=\"/\"} / node_filesystem_size_bytes{mountpoint=\"/\"})) * 100",
          "refId": "A"
        }
      ],
      "options": {
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "fieldConfig": {
        "defaults": {
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": 0},
              {"color": "yellow", "value": 70},
              {"color": "red", "value": 90}
            ]
          },
          "unit": "percent"
        }
      }
    },
    {
      "id": 6,
      "title": "Swap Usage (GB)",
      "type": "gauge",
      "datasource": "Prometheus",
      "gridPos": {"h": 8, "w": 6, "x": 6, "y": 16},
      "targets": [
        {
          "expr": "(node_memory_SwapTotal_bytes - node_memory_SwapFree_bytes) / 1024 / 1024 / 1024",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "max": 4,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": 0},
              {"color": "yellow", "value": 2},
              {"color": "red", "value": 3}
            ]
          },
          "unit": "decgbytes"
        }
      }
    },
    {
      "id": 7,
      "title": "Container Restarts (Last 24h)",
      "type": "stat",
      "datasource": "Prometheus",
      "gridPos": {"h": 8, "w": 6, "x": 12, "y": 16},
      "targets": [
        {
          "expr": "count(container_last_seen{id=~\"/system.slice/docker-.*\"})",
          "legendFormat": "Running Containers",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": 0},
              {"color": "yellow", "value": 1},
              {"color": "red", "value": 3}
            ]
          }
        }
      }
    },
    {
      "id": 8,
      "title": "Network I/O",
      "type": "graph",
      "datasource": "Prometheus",
      "gridPos": {"h": 8, "w": 6, "x": 18, "y": 16},
      "targets": [
        {
          "expr": "rate(node_network_receive_bytes_total[5m])",
          "legendFormat": "RX {{device}}",
          "refId": "A"
        },
        {
          "expr": "rate(node_network_transmit_bytes_total[5m])",
          "legendFormat": "TX {{device}}",
          "refId": "B"
        }
      ],
      "yaxes": [
        {"format": "Bps"},
        {"format": "short"}
      ]
    }
  ],
  "time": {"from": "now-1h", "to": "now"},
  "timepicker": {
    "refresh_intervals": ["10s", "30s", "1m", "5m", "15m", "30m", "1h"]
  }
}
