# Multi-stage build for Flask + React Dashboard
FROM python:3.11-slim as backend

WORKDIR /app

# Install backend dependencies
COPY src/dashboard/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy backend source
COPY src/dashboard/flaskapi_docker.py ./flaskapi.py
COPY src/dashboard/sentiment_analyzer.py ./

# Install Node.js for frontend build
FROM node:18-alpine as frontend

WORKDIR /app/frontend

# Copy frontend files
COPY src/dashboard/frontend/package*.json ./
RUN npm ci

COPY src/dashboard/frontend/ ./
RUN npm run build

# Final runtime image
FROM python:3.11-slim

WORKDIR /app

# Copy backend from first stage
COPY --from=backend /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=backend /app/*.py ./

# Copy frontend build from second stage
COPY --from=frontend /app/frontend/dist ./static

# Expose port
EXPOSE 8000

# Run Flask app
CMD ["python", "flaskapi.py"]
