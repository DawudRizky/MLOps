{
  "title": "MLOps - Topic Tracker Overview",
  "tags": ["mlops", "topics", "bertopic"],
  "timezone": "browser",
  "schemaVersion": 16,
  "version": 0,
  "refresh": "30s",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": false,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "panels": [
    {
      "id": 1,
      "title": "API Request Rate",
      "type": "graph",
      "targets": [
        {
          "expr": "rate(http_requests_total[5m])",
          "legendFormat": "{{method}} {{endpoint}}"
        }
      ],
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8}
    },
    {
      "id": 2,
      "title": "API Response Time",
      "type": "graph",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket[5m]))",
          "legendFormat": "p95"
        }
      ],
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8}
    },
    {
      "id": 3,
      "title": "Model Performance",
      "type": "stat",
      "targets": [
        {
          "expr": "model_confidence_score",
          "legendFormat": "Confidence"
        }
      ],
      "gridPos": {"x": 0, "y": 8, "w": 6, "h": 4}
    },
    {
      "id": 4,
      "title": "Topics Discovered",
      "type": "stat",
      "targets": [
        {
          "expr": "topic_count",
          "legendFormat": "Topics"
        }
      ],
      "gridPos": {"x": 6, "y": 8, "w": 6, "h": 4}
    },
    {
      "id": 5,
      "title": "Tweets Processed",
      "type": "stat",
      "targets": [
        {
          "expr": "tweets_processed_total",
          "legendFormat": "Total"
        }
      ],
      "gridPos": {"x": 12, "y": 8, "w": 6, "h": 4}
    },
    {
      "id": 6,
      "title": "Drift Detection Score",
      "type": "gauge",
      "targets": [
        {
          "expr": "drift_score",
          "legendFormat": "Drift"
        }
      ],
      "gridPos": {"x": 18, "y": 8, "w": 6, "h": 4}
    }
  ]
}
