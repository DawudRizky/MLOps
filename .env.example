# ===================================
# PEMERINTAH TOPIC TRACKER - ENV TEMPLATE
# ===================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to git!

# ===================================
# PROJECT CONFIGURATION
# ===================================
PROJECT_NAME=pemerintah-topic-tracker
ENVIRONMENT=development  # development, staging, production

# ===================================
# TWITTER SCRAPER
# ===================================
# Search query
TWITTER_SEARCH_QUERY=pemerintah lang:id -filter:retweets

# Scraping limits
TWITTER_MAX_TWEETS=1000
TWITTER_TIMEOUT=300

# Anti-bot delays (seconds)
TWITTER_MIN_DELAY=2.0
TWITTER_MAX_DELAY=8.0

# Proxy (optional)
# TWITTER_PROXY=http://your-proxy:8080

# ===================================
# MINIO (S3-COMPATIBLE STORAGE)
# ===================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123  # CHANGE THIS!
MINIO_ENDPOINT=localhost:9000
MINIO_CONSOLE_PORT=9001

# Bucket names (created automatically on startup)
BUCKET_DATA=mlops-data          # Main data bucket (raw/, processed/, metadata/, mlflow-artifacts/)
BUCKET_MODELS=mlops-models      # Trained models bucket (models/)

# MinIO credentials for application services
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123  # CHANGE THIS!

# ===================================
# MLFLOW
# ===================================
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_BACKEND_STORE_URI=postgresql://mlflow:mlflow123@postgres:5432/mlflow
MLFLOW_ARTIFACT_ROOT=s3://mlops-data/mlflow-artifacts
MLFLOW_S3_ENDPOINT_URL=http://minio:9000

# ===================================
# POSTGRESQL
# ===================================
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=mlflow123  # CHANGE THIS!
POSTGRES_DB=mlflow
POSTGRES_PORT=5432

# ===================================
# PGADMIN (DATABASE ADMIN UI)
# ===================================
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin123  # CHANGE THIS!

# ===================================
# REDIS
# ===================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=  # Leave empty for no password
REDIS_DB=0

# ===================================
# DVC (DATA VERSION CONTROL)
# ===================================
DVC_REMOTE_URL=s3://mlops-data/dvc-remote
DVC_REMOTE_ENDPOINT=http://localhost:9000

# AWS credentials for DVC (MinIO)
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin123  # CHANGE THIS!
AWS_ENDPOINT_URL=http://localhost:9000

# ===================================
# BERTOPIC MODEL
# ===================================
# Model configuration
EMBEDDING_MODEL=indobenchmark/indobert-base-p1
MIN_TOPIC_SIZE=10
NR_TOPICS=auto
TOP_N_WORDS=10

# Drift detection thresholds
DRIFT_THRESHOLD_DISTRIBUTION=0.15
DRIFT_THRESHOLD_CONFIDENCE=0.10
DRIFT_THRESHOLD_NEW_TOPICS=0.20

# ===================================
# QUALITY GATE
# ===================================
# Batch validation thresholds
MIN_BATCH_SIZE=50
MAX_DUPLICATES_RATIO=0.05
MIN_TEXT_LENGTH=10
MAX_TEXT_LENGTH=500

# ===================================
# FASTAPI BACKEND
# ===================================
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_RELOAD=true  # Set to false in production

# CORS settings
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ===================================
# REACT FRONTEND
# ===================================
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws

# ===================================
# PROMETHEUS
# ===================================
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=15d

# ===================================
# GRAFANA
# ===================================
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin123  # CHANGE THIS!

# ===================================
# LOKI
# ===================================
LOKI_PORT=3100

# ===================================
# NGINX (REVERSE PROXY)
# ===================================
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# Blue-Green deployment
ACTIVE_DEPLOYMENT=blue  # blue or green
BLUE_API_PORT=8001
GREEN_API_PORT=8002

# ===================================
# GITHUB ACTIONS (CI/CD)
# ===================================
# Self-hosted runner token
# GITHUB_RUNNER_TOKEN=your-runner-token

# Notifications (optional)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ===================================
# LEARNING STRATEGY
# ===================================
# Incremental learning schedule
INCREMENTAL_LEARNING_SCHEDULE="0 0 * * 0"  # Every Sunday at midnight

# Full retrain schedule
FULL_RETRAIN_SCHEDULE="0 2 1 * *"  # First day of month at 2 AM

# ===================================
# DATA COLLECTION SCHEDULE
# ===================================
# Scraper schedule (every 6 hours)
SCRAPER_SCHEDULE="0 */6 * * *"  # At minute 0 of every 6th hour

# ===================================
# ALERTING
# ===================================
# Alert thresholds
ALERT_DRIFT_THRESHOLD=0.20
ALERT_MODEL_CONFIDENCE_MIN=0.70
ALERT_API_LATENCY_MS=1000

# Email alerts (optional)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# ALERT_EMAIL_TO=team@example.com

# ===================================
# DEVELOPMENT
# ===================================
# Debug mode
DEBUG=false

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# ===================================
# SECURITY
# ===================================
# API keys (generate secure random strings)
API_SECRET_KEY=your-secret-key-here-change-this  # CHANGE THIS!
JWT_SECRET_KEY=your-jwt-secret-here-change-this  # CHANGE THIS!

# Session expiry (seconds)
SESSION_EXPIRY=3600

# ===================================
# NOTES
# ===================================
# 1. Change all passwords marked with "CHANGE THIS!"
# 2. Generate secure random strings for API keys:
#    python -c "import secrets; print(secrets.token_urlsafe(32))"
# 3. For production, use strong passwords (16+ characters)
# 4. Never commit .env file to version control
# 5. Keep cookies.json secure and out of git
