{
  "title": "MLOps Pipeline & Services",
  "uid": "mlops-pipeline",
  "timezone": "browser",
  "schemaVersion": 16,
  "version": 1,
  "refresh": "1m",
  "panels": [
    {
      "id": 1,
      "title": "Prometheus",
      "type": "singlestat",
      "datasource": "Prometheus",
      "gridPos": {"h": 3, "w": 4, "x": 0, "y": 0},
      "targets": [{"expr": "up{job=\"prometheus\"}", "refId": "A", "instant": true}],
      "valueName": "current",
      "format": "none",
      "valueMaps": [{"value": "1", "text": "UP"}, {"value": "0", "text": "DOWN"}],
      "colorBackground": true,
      "thresholds": "0.5,1",
      "colors": ["#d44a3a", "#e0b400", "#299c46"]
    },
    {
      "id": 2,
      "title": "Grafana",
      "type": "singlestat",
      "datasource": "Prometheus",
      "gridPos": {"h": 3, "w": 4, "x": 4, "y": 0},
      "targets": [{"expr": "up{job=\"grafana\"}", "refId": "A", "instant": true}],
      "valueName": "current",
      "format": "none",
      "valueMaps": [{"value": "1", "text": "UP"}, {"value": "0", "text": "DOWN"}],
      "colorBackground": true,
      "thresholds": "0.5,1",
      "colors": ["#d44a3a", "#e0b400", "#299c46"]
    },
    {
      "id": 3,
      "title": "Loki",
      "type": "singlestat",
      "datasource": "Prometheus",
      "gridPos": {"h": 3, "w": 4, "x": 8, "y": 0},
      "targets": [{"expr": "up{job=\"loki\"}", "refId": "A", "instant": true}],
      "valueName": "current",
      "format": "none",
      "valueMaps": [{"value": "1", "text": "UP"}, {"value": "0", "text": "DOWN"}],
      "colorBackground": true,
      "thresholds": "0.5,1",
      "colors": ["#d44a3a", "#e0b400", "#299c46"]
    },
    {
      "id": 4,
      "title": "cAdvisor",
      "type": "singlestat",
      "datasource": "Prometheus",
      "gridPos": {"h": 3, "w": 4, "x": 12, "y": 0},
      "targets": [{"expr": "up{job=\"cadvisor\"}", "refId": "A", "instant": true}],
      "valueName": "current",
      "format": "none",
      "valueMaps": [{"value": "1", "text": "UP"}, {"value": "0", "text": "DOWN"}],
      "colorBackground": true,
      "thresholds": "0.5,1",
      "colors": ["#d44a3a", "#e0b400", "#299c46"]
    },
    {
      "id": 5,
      "title": "Node Exporter",
      "type": "singlestat",
      "datasource": "Prometheus",
      "gridPos": {"h": 3, "w": 4, "x": 16, "y": 0},
      "targets": [{"expr": "up{job=\"node\"}", "refId": "A", "instant": true}],
      "valueName": "current",
      "format": "none",
      "valueMaps": [{"value": "1", "text": "UP"}, {"value": "0", "text": "DOWN"}],
      "colorBackground": true,
      "thresholds": "0.5,1",
      "colors": ["#d44a3a", "#e0b400", "#299c46"]
    },
    {
      "id": 6,
      "title": "API",
      "type": "singlestat",
      "datasource": "Prometheus",
      "gridPos": {"h": 3, "w": 4, "x": 20, "y": 0},
      "targets": [{"expr": "up{job=\"api-blue\"}", "refId": "A", "instant": true}],
      "valueName": "current",
      "format": "none",
      "valueMaps": [{"value": "1", "text": "UP"}, {"value": "0", "text": "DOWN"}],
      "colorBackground": true,
      "thresholds": "0.5,1",
      "colors": ["#d44a3a", "#e0b400", "#299c46"]
    },
    {
      "id": 7,
      "title": "MLflow",
      "type": "singlestat",
      "datasource": "Prometheus",
      "gridPos": {"h": 3, "w": 8, "x": 0, "y": 3},
      "targets": [{"expr": "count(container_last_seen{id=~\"/system.slice/docker-894496faae87.*\"})", "refId": "A", "instant": true}],
      "valueName": "current",
      "format": "none",
      "valueMaps": [{"value": "1", "text": "UP"}, {"value": "0", "text": "DOWN"}],
      "colorBackground": true,
      "thresholds": "0.5,1",
      "colors": ["#d44a3a", "#e0b400", "#299c46"]
    },
    {
      "id": 8,
      "title": "MinIO",
      "type": "singlestat",
      "datasource": "Prometheus",
      "gridPos": {"h": 3, "w": 8, "x": 8, "y": 3},
      "targets": [{"expr": "count(container_last_seen{id=~\"/system.slice/docker-dec2df7646d4.*\"})", "refId": "A", "instant": true}],
      "valueName": "current",
      "format": "none",
      "valueMaps": [{"value": "1", "text": "UP"}, {"value": "0", "text": "DOWN"}],
      "colorBackground": true,
      "thresholds": "0.5,1",
      "colors": ["#d44a3a", "#e0b400", "#299c46"]
    },
    {
      "id": 9,
      "title": "Airflow",
      "type": "singlestat",
      "datasource": "Prometheus",
      "gridPos": {"h": 3, "w": 8, "x": 16, "y": 3},
      "targets": [{"expr": "count(container_last_seen{id=~\"/system.slice/docker-0501e42390a3.*\"})", "refId": "A", "instant": true}],
      "valueName": "current",
      "format": "none",
      "valueMaps": [{"value": "1", "text": "UP"}, {"value": "0", "text": "DOWN"}],
      "colorBackground": true,
      "thresholds": "0.5,1",
      "colors": ["#d44a3a", "#e0b400", "#299c46"]
    },
    {
      "id": 10,
      "title": "Container Memory Usage (Top 10)",
      "type": "graph",
      "datasource": "Prometheus",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 6},
      "targets": [
        {
          "expr": "topk(10, container_memory_usage_bytes{id=~\"/system.slice/docker-.*\"}) / 1024 / 1024",
          "legendFormat": "Container",
          "refId": "A"
        }
      ],
      "yaxes": [
        {"format": "megabytes"},
        {"format": "short"}
      ]
    },
    {
      "id": 11,
      "title": "PostgreSQL Container Memory Usage",
      "type": "graph",
      "datasource": "Prometheus",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 6},
      "targets": [
        {
          "expr": "sum(container_memory_usage_bytes{id=~\".*postgres.*\"}) / 1024 / 1024",
          "legendFormat": "PostgreSQL MB",
          "refId": "A"
        }
      ],
      "yaxes": [
        {"format": "megabytes"},
        {"format": "short"}
      ]
    },
    {
      "id": 12,
      "title": "System Memory",
      "type": "gauge",
      "datasource": "Prometheus",
      "gridPos": {"h": 4, "w": 8, "x": 0, "y": 14},
      "targets": [
        {
          "expr": "(1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": 0},
              {"color": "yellow", "value": 70},
              {"color": "red", "value": 90}
            ]
          },
          "unit": "percent"
        }
      }
    },
    {
      "id": 13,
      "title": "CPU Usage",
      "type": "gauge",
      "datasource": "Prometheus",
      "gridPos": {"h": 4, "w": 8, "x": 8, "y": 14},
      "targets": [
        {
          "expr": "(1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m]))) * 100",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": 0},
              {"color": "yellow", "value": 80},
              {"color": "red", "value": 95}
            ]
          },
          "unit": "percent"
        }
      }
    },
    {
      "id": 14,
      "title": "Containers Running",
      "type": "stat",
      "datasource": "Prometheus",
      "gridPos": {"h": 4, "w": 8, "x": 16, "y": 14},
      "targets": [
        {
          "expr": "count(container_last_seen{id=~\"/system.slice/docker-.*\"})",
          "legendFormat": "Total",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto"
      }
    }
  ],
  "time": {"from": "now-1h", "to": "now"},
  "timepicker": {
    "refresh_intervals": ["30s", "1m", "5m", "15m", "30m", "1h"]
  }
}
